---
import BaseLayout from "../layouts/BaseLayout.astro";

const modules = import.meta.glob("./reading/*.md", { eager: true });
const articles = Object.values(modules)
  .map((post) => ({
    ...post.frontmatter,
    url: post.url,
    tags: post.frontmatter.tags ?? [],
  }))
  .filter((post) => !post.draft)
  .sort((a, b) => new Date(b.date).valueOf() - new Date(a.date).valueOf());

const formatDate = (date) =>
  new Intl.DateTimeFormat("zh-CN", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(new Date(date));
---

<BaseLayout title="归档 | 每日阅读札记" description="按时间浏览所有阅读记录。">
  <section class="wrap page-title archive-header">
    <div>
      <p class="eyebrow">Archive</p>
      <h1>归档</h1>
    </div>
    <p>所有读过的文章按时间倒序排列，适合回看自己的注意力轨迹。</p>
  </section>

  <section class="wrap section archive-list">
    {articles.map((post) => (
      <article class="archive-item">
        <time datetime={new Date(post.date).toISOString()}>{formatDate(post.date)}</time>
        <div>
          <h2><a href={post.url}>{post.title}</a></h2>
          <p>{post.description}</p>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
