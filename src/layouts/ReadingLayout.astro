---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path) => `${base}${path.replace(/^\//, "")}`;
const date = new Date(frontmatter.date);
const dateText = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(date);
const tags = frontmatter.tags ?? [];
const slugify = (tag) =>
  String(tag)
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "-")
    .replace(/[^\p{L}\p{N}_-]+/gu, "");
---

<BaseLayout title={`${frontmatter.title} | 每日阅读札记`} description={frontmatter.description}>
  <div class="wrap entry-shell">
    <article>
      <header class="entry-header">
        <p class="eyebrow">Reading Note</p>
        <h1>{frontmatter.title}</h1>
        <div class="entry-meta">
          <time datetime={date.toISOString()}>{dateText}</time>
          {frontmatter.author && <span>{frontmatter.author}</span>}
          {frontmatter.source && <span>{frontmatter.source}</span>}
        </div>
        {frontmatter.description && <p class="entry-summary">{frontmatter.description}</p>}
        <div class="article-actions">
          {frontmatter.sourceUrl && <a class="button" href={frontmatter.sourceUrl} target="_blank" rel="noreferrer">查看原文</a>}
          <a class="ghost-button" href={withBase("/archive/")}>回到归档</a>
        </div>
      </header>
      <div class="entry-content">
        <slot />
      </div>
    </article>
    <aside class="entry-sidebar" aria-label="文章信息">
      <h2>记录字段</h2>
      <p>{frontmatter.mood ?? "读完之后，给它留一个位置。"}</p>
      {tags.length > 0 && (
        <div class="tag-list">
          {tags.map((tag) => <a class="tag" href={withBase(`/tags/${slugify(tag)}/`)}>{tag}</a>)}
        </div>
      )}
    </aside>
  </div>
</BaseLayout>
