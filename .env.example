# Optional. The default mode uses Zotero Desktop's local API and does not need a key.
ZOTERO_MODE=local
ZOTERO_LOCAL_BASE_URL=http://127.0.0.1:23119/api
ZOTERO_USER_ID=0

# Optional. Import only one Zotero collection.
# You can set either the collection key or its exact name.
# ZOTERO_COLLECTION_KEY=
# ZOTERO_COLLECTION_NAME=Reading Blog

# Optional. Use the Zotero Web API instead of the local desktop API.
# ZOTERO_MODE=web
# ZOTERO_API_KEY=
# ZOTERO_USER_ID=

# Optional import behavior.
ZOTERO_IMPORT_LIMIT=20
ZOTERO_POLL_SECONDS=60
